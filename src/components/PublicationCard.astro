---
import { Image } from 'astro:assets';
import { getTeaser } from '../lib/data';
import type { Publication, VenueInfo } from '../lib/data';

interface Props {
  pub: Publication;
  venueInfo: VenueInfo | undefined;
}

const { pub } = Astro.props;
const venueLabel = `${pub.venue} '${String(pub.year).slice(2)}`;
const isBestPaper = pub.award === 'Best Paper';
const teaser = getTeaser(pub.teaser);

// Condense long author lists; the full list lives in the paper detail.
const MAX_SHOWN = 3;
const shownAuthors = pub.authors.slice(0, MAX_SHOWN);
const hasMore = pub.authors.length > MAX_SHOWN;
---

<article class="pub-card" data-category={pub.category} data-slug={pub.slug}>
  {teaser && (
    <div class="pub-card-teaser">
      <Image
        src={teaser}
        alt={`Teaser figure for ${pub.title}`}
        widths={[96, 192]}
        sizes="72px"
        width={96}
        height={96}
        loading="lazy"
        decoding="async"
      />
    </div>
  )}

  <div class="pub-card-main">
    <div class="pub-card-header">
      <span class="venue-label">{venueLabel}</span>
      {pub.award && (
        <span class="award-badge">{isBestPaper ? '🏆' : '🥇'} {pub.award}</span>
      )}
    </div>

    <h3 class="pub-card-title">
      <button class="pub-card-open" data-open-paper={pub.slug}>
        {pub.emoji && <span class="pub-emoji" aria-hidden="true">{pub.emoji}</span>}
        <span class="pub-card-name">{pub.short_name ?? pub.title}</span>
      </button>
    </h3>

    {pub.short_desc && <p class="pub-short-desc">{pub.short_desc}</p>}

    <p class="pub-card-authors">
      {shownAuthors.map((a, i) => (
        <span class:list={{ highlight: a.highlight }}>
          {a.name}{i < shownAuthors.length - 1 ? ', ' : ''}
        </span>
      ))}
      {hasMore && <span class="pub-card-etal"> et al.</span>}
    </p>
  </div>
</article>

<style lang="scss">
  .pub-card {
    display: flex;
    gap: 0.8rem;
    background: var(--bg-surface);
    border: 1px solid var(--bg-surface-border);
    border-radius: var(--radius-md);
    padding: 0.85rem 1rem;
    transition: transform var(--transition-fast),
                box-shadow var(--transition-fast),
                border-color var(--transition-fast);

    &:hover,
    &:focus-within {
      transform: translateY(-3px);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
      border-color: var(--color-secondary);
    }

    &.glow {
      border-color: var(--color-secondary);
      box-shadow: 0 0 16px var(--color-highlight-glow);
    }
  }

  .pub-card-teaser {
    flex-shrink: 0;
    width: 72px;
    height: 72px;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: var(--bg-primary);
    border: 1px solid var(--bg-surface-border);

    :global(img) {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
  }

  .pub-card-main {
    flex: 1;
    min-width: 0;
  }

  .pub-card-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.3rem;
    flex-wrap: wrap;
  }

  .venue-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .award-badge {
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--color-accent);
  }

  .pub-card-title {
    margin: 0 0 0.2rem;
    font-size: inherit;
    font-weight: inherit;
  }

  // The whole card is the hit area, but only this is a real control:
  // it carries the accessible name and the focus ring.
  .pub-card-open {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    padding: 0;
    text-align: left;
    font-family: 'DM Sans', sans-serif;
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--color-primary);

    &::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: var(--radius-md);
    }

    &:hover .pub-card-name { text-decoration: underline; text-underline-offset: 0.15em; }
  }

  .pub-card { position: relative; }

  .pub-emoji { font-size: 1rem; }

  .pub-short-desc {
    color: var(--color-text);
    font-size: 0.82rem;
    line-height: 1.45;
    margin: 0 0 0.35rem;
  }

  .pub-card-authors {
    margin: 0;
    font-size: 0.75rem;
    line-height: 1.4;
    color: var(--color-text-muted);

    .highlight {
      font-weight: 600;
      color: var(--color-text);
    }
  }

  .pub-card-etal { font-style: italic; }

  @media (max-width: 480px) {
    .pub-card-teaser { width: 56px; height: 56px; }
    .pub-card { padding: 0.7rem 0.8rem; gap: 0.65rem; }
  }
</style>
