---
import type { Publication, VenueInfo } from '../lib/data';

interface Props {
  pub: Publication;
  venueInfo: VenueInfo | undefined;
}

const { pub } = Astro.props;
const venueLabel = `${pub.venue} '${String(pub.year).slice(2)}`;
const isBestPaper = pub.award === 'Best Paper';
const isHonorableMention = pub.award === 'Best Paper Honorable Mention';
---

<button
  class="pub-card"
  data-category={pub.category}
  data-slug={pub.slug}
  aria-label={`View details: ${pub.title}`}
>
  <div class="pub-card-header">
    <span class="venue-label">{venueLabel}</span>
    {isBestPaper ? (
      <span class="trophy-badge" aria-label="Best Paper" title="Best Paper">🏆 {pub.award}</span>
    ) : isHonorableMention ? (
      <span class="award-badge">🥇 {pub.award}</span>
    ) : null}
  </div>
  {pub.short_name ? (
    <div class="pub-card-body">
      <div class="pub-card-name-row">
        <span class="pub-emoji">{pub.emoji}</span>
        <strong class="pub-short-name">{pub.short_name}</strong>
      </div>
      <p class="pub-short-desc">{pub.short_desc}</p>
    </div>
  ) : (
    <h3 class="pub-card-title">{pub.title}</h3>
  )}
</button>

<style lang="scss">
  .pub-card {
    display: block;
    width: 100%;
    text-align: left;
    background: var(--bg-surface);
    border: 1px solid var(--bg-surface-border);
    border-radius: var(--radius-md);
    padding: 0.85rem 1rem;
    cursor: pointer;
    transition: transform var(--transition-fast),
                box-shadow var(--transition-fast),
                border-color var(--transition-fast);

    &:hover {
      transform: translateY(-4px);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
    }

    &.glow {
      border-color: var(--color-secondary);
      box-shadow: 0 0 16px var(--color-highlight-glow);
      transform: scale(1.03);
    }
  }

  .pub-card-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.45rem;
    flex-wrap: wrap;
  }

  .venue-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .award-badge {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--color-accent);
  }

  .trophy-badge {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--color-accent);
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .pub-card-title {
    font-family: 'Source Sans 3', sans-serif;
    font-size: 0.88rem;
    font-weight: 500;
    line-height: 1.4;
    color: var(--color-text);
  }

  .pub-card-name-row {
    display: flex;
    align-items: center;
    gap: 0.25em;
    margin-bottom: 0.2rem;
  }

  .pub-emoji {
    font-size: 1rem;
  }

  .pub-short-name {
    font-family: 'DM Sans', sans-serif;
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--color-primary);
  }

  .pub-short-desc {
    color: var(--color-text-muted);
    font-size: 0.82rem;
    line-height: 1.4;
    margin: 0;
  }
</style>
