---
/**
 * JobMarketBanner — a quiet, dismissible line near the top of the homepage.
 *
 * All copy and links come from `job_market_banner` in src/data/site.yaml.
 * To remove the banner entirely, set `enabled: false` there. That is the
 * only edit required; this component renders nothing when disabled.
 */
import { getSiteConfig } from '../lib/data';

const { job_market_banner: banner } = getSiteConfig();
---

{banner.enabled && (
  <aside class="job-banner" data-job-banner aria-label="Job market availability">
    <p class="job-banner-text">
      <strong class="job-banner-heading">{banner.heading}.</strong>
      {' '}{banner.body}
    </p>
    <p class="job-banner-links">
      {banner.links.map(link => (
        <a href={link.href}>{link.label}</a>
      ))}
    </p>
    {banner.dismissible && (
      <button class="job-banner-dismiss" data-job-banner-dismiss type="button" aria-label="Dismiss this notice">
        <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
          <path d="M4 4l8 8M12 4l-8 8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        </svg>
      </button>
    )}
  </aside>
)}

<style lang="scss">
  .job-banner {
    display: flex;
    align-items: baseline;
    gap: 0.75rem 1rem;
    flex-wrap: wrap;
    padding: 0.75rem 1rem;
    margin-bottom: 1.75rem;
    background: var(--bg-surface);
    border: 1px solid var(--bg-surface-border);
    // A single accent rule carries the emphasis, rather than a filled block.
    border-left: 3px solid var(--color-secondary);
    border-radius: var(--radius-md);
  }

  .job-banner-text {
    flex: 1 1 22rem;
    min-width: 0;
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--color-text);
  }

  .job-banner-heading {
    font-weight: 600;
    color: var(--color-primary);
  }

  .job-banner-links {
    display: flex;
    gap: 1rem;
    margin: 0;
    font-size: 0.85rem;
    font-weight: 500;

    a {
      color: var(--color-primary);
      text-decoration: underline;
      text-underline-offset: 0.2em;
      text-decoration-thickness: 1px;
      text-decoration-color: var(--bg-surface-border);

      &:hover { text-decoration-color: currentColor; }
    }
  }

  .job-banner-dismiss {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    margin-left: auto;
    border-radius: var(--radius-sm);
    color: var(--color-text-muted);
    transition: background-color var(--transition-fast), color var(--transition-fast);

    &:hover {
      background: var(--bg-surface-border);
      color: var(--color-text);
    }
  }

  @media (max-width: 480px) {
    .job-banner {
      padding: 0.7rem 0.85rem;
      gap: 0.5rem 0.75rem;
    }

    .job-banner-text { font-size: 0.88rem; }
  }
</style>

<script>
  // Dismissal is a per-visitor convenience only: it is stored in this
  // browser and never leaves it. Storage can throw (private windows,
  // blocked site data), so every access is guarded and the banner simply
  // stays visible if storage is unavailable.
  const KEY = 'job-banner-dismissed';

  function initJobBanner() {
    const banner = document.querySelector<HTMLElement>('[data-job-banner]');
    if (!banner) return;

    try {
      if (localStorage.getItem(KEY) === '1') {
        banner.hidden = true;
        return;
      }
    } catch { /* storage unavailable — leave the banner visible */ }

    const dismiss = banner.querySelector<HTMLButtonElement>('[data-job-banner-dismiss]');
    dismiss?.addEventListener('click', () => {
      banner.hidden = true;
      try {
        localStorage.setItem(KEY, '1');
      } catch { /* not persisting is fine */ }
    });
  }

  initJobBanner();
  document.addEventListener('astro:after-swap', initJobBanner);
</script>
