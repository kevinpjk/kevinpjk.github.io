---
/**
 * ManuscriptEntry — one row in the "Manuscripts Under Submission" section.
 *
 * Deliberately not PublicationEntry: these carry no venue and no detail
 * overlay, and their title and figure are placeholders until Kevin supplies
 * the final material. Nothing here is clickable unless a link exists.
 */
import { manuscriptLinks } from '../lib/data';
import type { Manuscript } from '../lib/data';

interface Props {
  manuscript: Manuscript;
  label: string;
}

const { manuscript: m, label } = Astro.props;
const links = manuscriptLinks(m);
---

<article class="ms-row" id={`pub-${m.slug}`}>
  <div class="ms-thumb">
    <span class="ms-thumb-placeholder" aria-hidden="true">Figure<br />to come</span>
  </div>

  <div class="ms-body">
    <h3 class="ms-title">{m.title}</h3>

    <p class="ms-authors">
      {m.authors.map((a, i) => (
        <span class:list={{ highlight: a.highlight }}>
          {a.name}{i < m.authors.length - 1 ? ', ' : ''}
        </span>
      ))}
    </p>

    <p class="ms-meta">
      <span class="ms-status">{label}</span>
      {links.map(l => (
        <a href={l.url} target="_blank" rel="noopener noreferrer">{l.label}</a>
      ))}
    </p>
  </div>
</article>

<style lang="scss">
  .ms-row {
    display: grid;
    grid-template-columns: 104px minmax(0, 1fr);
    gap: 1.1rem;
    padding: 1rem;
    margin: 0 -1rem;
    border-radius: var(--radius-md);

    & + & { box-shadow: 0 -1px 0 var(--bg-surface-border); }
  }

  .ms-thumb {
    width: 104px;
    height: 72px;
    border-radius: var(--radius-sm);
    overflow: hidden;
    border: 1px dashed var(--bg-surface-border);
    background: var(--bg-surface);
  }

  .ms-thumb-placeholder {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.55rem;
    line-height: 1.4;
    text-align: center;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
  }

  .ms-body { min-width: 0; }

  .ms-title {
    margin: 0 0 0.3rem;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: -0.005em;
    color: var(--color-text);
  }

  .ms-authors {
    margin: 0 0 0.3rem;
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--color-text-muted);

    .highlight {
      font-weight: 600;
      color: var(--color-text);
    }
  }

  .ms-meta {
    display: flex;
    align-items: baseline;
    gap: 0.85rem;
    flex-wrap: wrap;
    margin: 0;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    letter-spacing: 0.02em;

    a {
      color: var(--color-text-muted);
      text-decoration: underline;
      text-underline-offset: 0.22em;
      text-decoration-color: var(--bg-surface-border);

      &:hover {
        color: var(--color-primary);
        text-decoration-color: currentColor;
      }
    }
  }

  .ms-status {
    font-style: italic;
    color: var(--color-text-muted);
  }

  @media (max-width: 560px) {
    .ms-row {
      grid-template-columns: 72px minmax(0, 1fr);
      gap: 0.8rem;
      padding: 0.8rem;
      margin: 0 -0.8rem;
    }

    .ms-thumb { width: 72px; height: 52px; }
    .ms-title { font-size: 0.88rem; }
  }
</style>
