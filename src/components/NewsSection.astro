---
import { getNews } from '../lib/data';

interface Props {
  /** Show only the most recent N entries. Omit for all. */
  limit?: number;
}

const { limit } = Astro.props;
const allNews = getNews();
const news = limit ? allNews.slice(0, limit) : allNews;

// Simple markdown-to-HTML: links, bold, italic
function renderMarkdown(text: string): string {
  return text
    // bold: **text**
    .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
    // italic: _text_ (must run before link replacement to avoid matching _blank in href attributes)
    .replace(/_([^_]+)_/g, '<em>$1</em>')
    // links: [text](url)
    .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank" rel="noopener noreferrer">$1</a>');
}

function formatDate(dateStr: string): string {
  const d = new Date(dateStr + 'T00:00:00');
  return d.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
}
---

<section class="news-section">
  <h2 class="section-heading">News</h2>
  <div class="news-scroll">
    {news.map(item => (
      <div class="news-item">
        <span class="news-date mono">{formatDate(item.date)}</span>
        <span class="news-content" set:html={renderMarkdown(item.content)} />
      </div>
    ))}
  </div>
</section>

<style lang="scss">
  .news-section {
    margin-top: 2rem;
  }

  .section-heading {
    font-family: 'Fraunces', serif;
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.005em;
    margin-bottom: 0.6rem;
    color: var(--color-text-muted);
  }

  // No max-height / overflow: the homepage passes a fixed `limit`, and an
  // overflow container here would be another sticky-breaking scrollport.
  .news-scroll { padding-right: 0; }

  .news-item {
    display: flex;
    gap: 1rem;
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--bg-surface-border);
    font-size: 0.88rem;
    line-height: 1.55;

    &:last-child {
      border-bottom: none;
    }
  }

  .news-date {
    flex-shrink: 0;
    width: 5.5rem;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-secondary);
    padding-top: 0.2rem;
  }

  .news-content {
    color: var(--color-text);

    :global(a) {
      color: var(--color-primary);
      &:hover {
        color: var(--color-secondary);
      }
    }

    :global(em) {
      font-style: italic;
      color: var(--color-accent);
    }
  }

  @media (max-width: 480px) {
    .news-item {
      flex-direction: column;
      gap: 0.15rem;
      font-size: 0.85rem;
    }

    .news-date {
      width: auto;
      font-size: 0.75rem;
    }
  }
</style>
