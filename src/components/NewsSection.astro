---
import { getNews } from '../lib/data';

interface Props {
  /**
   * How many rows are visible before the list scrolls. All entries are
   * rendered; this only caps the height.
   */
  visibleRows?: number;
}

const { visibleRows } = Astro.props;
const news = getNews();

/**
 * Simple markdown-to-HTML: links, bold, italic.
 *
 * Links are pulled out first and held aside, so the inline rules never see a
 * URL. Running italic first — to keep it away from the `_blank` in the href
 * it was about to write — meant a filename like `Kevin_Jiankai_Pu_CV.pdf` had
 * its underscores turned into `<em>` tags, and the link 404'd.
 */
function renderMarkdown(text: string): string {
  const links: string[] = [];
  const held = text.replace(/\[([^\]]+)\]\(([^)]+)\)/g, (_match, label, href) => {
    const index = links.push(
      `<a href="${href}" target="_blank" rel="noopener noreferrer">${label}</a>`,
    ) - 1;
    return `\u0000${index}\u0000`;
  });

  return held
    .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
    .replace(/_([^_]+)_/g, '<em>$1</em>')
    .replace(/\u0000(\d+)\u0000/g, (_match, index) => links[Number(index)]);
}

function formatDate(dateStr: string): string {
  const d = new Date(dateStr + 'T00:00:00');
  return d.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
}
---

<section class="news-section">
  <h2 class="section-heading">News</h2>
  <div
    class="news-scroll"
    style={visibleRows ? `--news-visible-rows: ${visibleRows}` : undefined}
    tabindex="0"
    role="region"
    aria-label="News, scrollable"
  >
    {news.map(item => (
      <div class="news-item">
        <span class="news-date mono">{formatDate(item.date)}</span>
        <span class="news-content" set:html={renderMarkdown(item.content)} />
      </div>
    ))}
  </div>
</section>

<style lang="scss">
  .news-section {
    margin-top: 2rem;
  }

  .section-heading {
    font-family: 'Fraunces', serif;
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.005em;
    margin-bottom: 0.6rem;
    color: var(--color-text-muted);
  }

  // Caps the height to roughly `--news-visible-rows` rows and scrolls the
  // rest. Only this element's own descendants are affected, so it does not
  // interfere with the sticky sidebar elsewhere on the page.
  .news-scroll {
    // Fallback estimate, replaced with an exact measurement by the script
    // below once layout settles. Rows wrap differently at different widths,
    // so a fixed guess can show four rows on a wide screen and two on a
    // narrow one.
    --news-row-height: 4.45rem;
    max-height: calc(var(--news-visible-rows, 3) * var(--news-row-height));
    overflow-y: auto;
    overscroll-behavior: contain;
    padding-right: 0.5rem;

    &:focus-visible {
      outline: 2px solid var(--color-primary);
      outline-offset: 4px;
      border-radius: var(--radius-sm);
    }

    &::-webkit-scrollbar { width: 4px; }
    &::-webkit-scrollbar-track { background: transparent; }
    &::-webkit-scrollbar-thumb {
      background: var(--bg-surface-border);
      border-radius: 2px;
    }
  }

  .news-item {
    display: flex;
    gap: 1rem;
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--bg-surface-border);
    font-size: 0.88rem;
    line-height: 1.55;

    &:last-child {
      border-bottom: none;
    }
  }

  .news-date {
    flex-shrink: 0;
    width: 5.5rem;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-secondary);
    padding-top: 0.2rem;
  }

  .news-content {
    color: var(--color-text);

    :global(a) {
      color: var(--color-primary);
      &:hover {
        color: var(--color-secondary);
      }
    }

    :global(em) {
      font-style: italic;
      color: var(--color-accent);
    }
  }

  @media (max-width: 480px) {
    .news-item {
      flex-direction: column;
      gap: 0.15rem;
      font-size: 0.85rem;
    }

    .news-date {
      width: auto;
      font-size: 0.75rem;
    }
  }
</style>

<script>
  // Cap the list at exactly N rows by measuring where row N+1 starts, rather
  // than trusting a fixed row-height estimate.
  function capNewsHeight() {
    document.querySelectorAll<HTMLElement>('.news-scroll').forEach(list => {
      const rows = list.querySelectorAll<HTMLElement>('.news-item');
      const visible = Number(
        getComputedStyle(list).getPropertyValue('--news-visible-rows').trim() || 3
      );
      const cutoff = rows[visible];
      if (!cutoff || rows.length <= visible) return;
      list.style.maxHeight = `${cutoff.offsetTop - list.firstElementChild!.offsetTop}px`;
    });
  }

  capNewsHeight();
  addEventListener('resize', capNewsHeight);
  document.addEventListener('astro:after-swap', capNewsHeight);
</script>
