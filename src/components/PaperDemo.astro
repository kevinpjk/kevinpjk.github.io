---
/**
 * PaperDemo — frame for a live paper demo.
 *
 * The initial scene and the full transcript are rendered into static HTML
 * here, so with JavaScript disabled or blocked the demo degrades to a
 * screenshot-like figure plus a readable walkthrough. Controls start hidden
 * and are revealed by the loader, so a non-JS visitor never sees a dead
 * button.
 *
 * A paper with no module under src/demos/papers/ renders a placeholder.
 */
import { demos } from '../demos/registry';

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const demo = demos[slug];
---

{demo ? (
  <figure
    class="paper-demo"
    data-paper-demo
    data-demo-id={demo.id}
  >
    <div class="demo-stage-wrap">
      <div class="demo-stage" data-demo-stage role="img" aria-label={demo.stageLabel} set:html={demo.scene()} />

      <div class="demo-controls" data-demo-controls hidden>
        <button class="demo-btn" type="button" data-demo-action="pause" hidden>Pause</button>
        <button class="demo-btn" type="button" data-demo-action="reset" aria-label="Reset the demo">Reset</button>
      </div>
    </div>

    <p class="demo-hint">{demo.hint}</p>

    <p class="demo-live cd-sr" data-demo-live role="status" aria-live="polite" aria-atomic="true"></p>
    <p class="demo-status" data-demo-status role="status" hidden></p>

    {/*
      The walkthrough is the demo's text alternative and its no-JS fallback.
      It is visually hidden rather than deleted, so screen-reader users and
      anyone without JavaScript still get a description of what happens.
    */}
    <ol class="cd-sr">
      {demo.transcript.map(line => <li>{line}</li>)}
    </ol>
  </figure>
) : (
  <div class="paper-demo paper-demo--placeholder">
    <p class="demo-placeholder-text">Interactive demo in progress.</p>
  </div>
)}

<style lang="scss">
  // A query container, so a demo scene lays itself out from the width it
  // actually has rather than from the viewport. The same demo appears in a
  // Selected Work row and in a detail overlay column, at different widths on
  // the same screen, so the viewport says nothing useful about either.
  .paper-demo {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-width: 0;
    container: demo / inline-size;
  }

  .demo-stage-wrap {
    position: relative;
    border: 1px solid var(--bg-surface-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .demo-hint {
    margin: 0;
    font-size: 0.74rem;
    line-height: 1.45;
    color: var(--color-text-muted);
  }

  // Top-right of the stage. The bottom-right corner is where the breakout
  // panel sits, and the controls were unreadable on top of it.
  .demo-controls {
    position: absolute;
    right: 0.4rem;
    top: 0.34rem;
    display: flex;
    gap: 0.3rem;
    z-index: 6;

    // `display: flex` outranks the UA rule for [hidden], so without this the
    // loader's "stay hidden until JS is ready" guarantee does nothing and a
    // visitor with JavaScript off gets a Reset button that cannot work.
    &[hidden] { display: none; }
  }

  .demo-btn {
    min-height: 22px;
    padding: 0.1rem 0.45rem;
    border: 1px solid var(--bg-surface-border);
    border-radius: var(--radius-sm);
    background: var(--bg-surface);
    color: var(--color-text-muted);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.58rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    opacity: 0.75;
    transition: border-color var(--transition-fast), color var(--transition-fast),
                opacity var(--transition-fast);

    &:hover {
      border-color: var(--color-secondary);
      color: var(--color-text);
      opacity: 1;
    }
  }

  .demo-status {
    margin: 0;
    font-size: 0.74rem;
    color: var(--color-accent);
  }

  .paper-demo--placeholder {
    display: grid;
    place-items: center;
    min-height: 210px;
    border: 1px dashed var(--bg-surface-border);
    border-radius: var(--radius-md);
    background: var(--bg-surface);
  }

  .demo-placeholder-text {
    margin: 0;
    font-size: 0.76rem;
    color: var(--color-text-muted);
    font-style: italic;
  }
</style>
