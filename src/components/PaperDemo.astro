---
/**
 * PaperDemo — frame for a live paper demo.
 *
 * The initial scene and the full transcript are rendered into static HTML
 * here, so with JavaScript disabled or blocked the demo degrades to a
 * screenshot-like figure plus a readable walkthrough. Controls start hidden
 * and are revealed by the loader, so a non-JS visitor never sees a dead
 * button.
 *
 * A paper with no module under src/demos/papers/ renders a placeholder.
 */
import { demos } from '../demos/registry';

interface Props {
  slug: string;
  /** Larger stage for the detail overlay; compact for the homepage row. */
  size?: 'compact' | 'full';
}

const { slug, size = 'compact' } = Astro.props;
const demo = demos[slug];
---

{demo ? (
  <figure
    class:list={['paper-demo', `paper-demo--${size}`]}
    data-paper-demo
    data-demo-id={demo.id}
  >
    <div class="demo-stage-wrap">
      <div class="demo-stage" data-demo-stage role="img" aria-label={demo.stageLabel} set:html={demo.scene()} />
      <span class="demo-badge">Scripted example</span>
    </div>

    <div class="demo-bar">
      <p class="demo-hint">{demo.hint}</p>
      <div class="demo-controls" data-demo-controls hidden>
        <button class="demo-btn" type="button" data-demo-action="pause" hidden>Pause</button>
        <button class="demo-btn" type="button" data-demo-action="reset" aria-label="Reset the demo">Reset</button>
      </div>
    </div>

    <p class="demo-live cd-sr" data-demo-live role="status" aria-live="polite" aria-atomic="true"></p>
    <p class="demo-status" data-demo-status role="status" hidden></p>

    <details class="demo-transcript">
      <summary>Read the walkthrough</summary>
      <ol>
        {demo.transcript.map(line => <li>{line}</li>)}
      </ol>
    </details>
  </figure>
) : (
  <div class:list={['paper-demo', 'paper-demo--placeholder', `paper-demo--${size}`]}>
    <p class="demo-placeholder-text">Interactive demo in progress.</p>
  </div>
)}

<style lang="scss">
  .paper-demo {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-width: 0;
  }

  .demo-stage-wrap {
    position: relative;
    border: 1px solid var(--bg-surface-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .demo-badge {
    position: absolute;
    right: 0.4rem;
    bottom: 0.4rem;
    padding: 0.1rem 0.4rem;
    border-radius: var(--radius-sm);
    background: var(--bg-primary);
    border: 1px solid var(--bg-surface-border);
    color: var(--color-text-muted);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.55rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    pointer-events: none;
  }

  .demo-bar {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .demo-hint {
    flex: 1 1 14rem;
    margin: 0;
    font-size: 0.74rem;
    line-height: 1.45;
    color: var(--color-text-muted);
  }

  .demo-controls {
    display: flex;
    gap: 0.4rem;
  }

  .demo-btn {
    min-height: 32px;
    padding: 0.25rem 0.7rem;
    border: 1px solid var(--bg-surface-border);
    border-radius: var(--radius-sm);
    background: var(--bg-surface);
    color: var(--color-text-muted);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.66rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    transition: border-color var(--transition-fast), color var(--transition-fast);

    &:hover {
      border-color: var(--color-secondary);
      color: var(--color-text);
    }
  }

  .demo-status {
    margin: 0;
    font-size: 0.74rem;
    color: var(--color-accent);
  }

  .demo-transcript {
    font-size: 0.74rem;
    color: var(--color-text-muted);

    summary {
      cursor: pointer;
      font-weight: 500;
      &:hover { color: var(--color-primary); }
    }

    ol {
      list-style: decimal;
      padding-left: 1.2rem;
      margin: 0.4rem 0 0;
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
      line-height: 1.55;
    }
  }

  .paper-demo--placeholder {
    display: grid;
    place-items: center;
    min-height: 210px;
    border: 1px dashed var(--bg-surface-border);
    border-radius: var(--radius-md);
    background: var(--bg-surface);
  }

  .demo-placeholder-text {
    margin: 0;
    font-size: 0.76rem;
    color: var(--color-text-muted);
    font-style: italic;
  }
</style>
