---
/**
 * PaperDetailOverlays — renders all paper detail overlays + tree-ring store
 * and wires up open/close interactions via event delegation.
 *
 * Triggered by explicit [data-open-paper] buttons (SelectedWork rows and
 * PublicationEntry rows). The overlay appears in-place; no
 * cross-page navigation, no URL pathname change — only the hash updates so
 * the detail is linkable.
 */
import PaperDetail from './PaperDetail.astro';
import TreeRing from './TreeRing.astro';
import { getPublications, getVenues } from '../lib/data';

const allPubs = getPublications();
const venues = getVenues();
---

{allPubs.map(pub => (
  <PaperDetail pub={pub} venueInfo={venues[pub.venue]} />
))}

<div id="tree-ring-store" style="display:none">
  {allPubs.map(pub => (
    <TreeRing pub={pub} />
  ))}
</div>

<script>
  function initPaperDetailOverlays() {
    // Move .paper-detail elements to <body> so they're siblings of
    // #main-content. Otherwise fading #main-content on open hides them too.
    document.querySelectorAll<HTMLElement>('.paper-detail').forEach(d => {
      if (d.parentElement !== document.body) document.body.appendChild(d);
    });

    // Move each tree-ring SVG into its paper-detail container (once)
    const store = document.getElementById('tree-ring-store');
    if (store) {
      store.querySelectorAll<SVGElement>('.tree-ring-svg').forEach(svg => {
        const slug = svg.dataset.slug;
        const container = document.querySelector<HTMLElement>(
          `.paper-detail[data-slug="${slug}"] .tree-ring-container`
        );
        if (container) container.appendChild(svg);
      });
      store.remove();
    }

    const mainContent = document.getElementById('main-content');

    // Where the reader was on the page before a detail took over. The overlay
    // is its own fixed scroll container, so the page underneath never needs to
    // move — but locking it can clamp the offset, and the browser's own
    // restoration does not know about an overlay that changes only the hash.
    // Remembering the offset and putting it back is what makes Back return to
    // the row the reader came from rather than the top of the page.
    let restoreScrollY = 0;

    // What had focus when the overlay opened, so it can be given back.
    let restoreFocus: HTMLElement | null = null;
    // Everything outside the overlay, made inert while it is up.
    let inerted: HTMLElement[] = [];

    /**
     * The detail is a modal dialog, so the page behind it must not be
     * reachable. `inert` does the whole job at once: it takes the background
     * out of the tab order, out of the accessibility tree, and out of
     * pointer reach, which is also why Tab stays inside without any key
     * handling of our own.
     */
    function sealBackground(active: HTMLElement) {
      inerted = Array.from(document.body.children).filter(
        (el): el is HTMLElement => el instanceof HTMLElement && el !== active && !el.inert,
      );
      inerted.forEach(el => { el.inert = true; });
    }

    function unsealBackground() {
      inerted.forEach(el => { el.inert = false; });
      inerted = [];
    }

    /** Which demos may autoplay depends on whether an overlay is open. */
    const notifyDemos = () => {
      document.dispatchEvent(new CustomEvent('demo:rebalance'));
    };

    function openDetail(slug: string) {
      const detail = document.querySelector<HTMLElement>(`.paper-detail[data-slug="${slug}"]`);
      if (!detail) return;

      // Only the first open records a position; re-entering from popstate
      // while one is already up would otherwise save the locked offset.
      if (!document.querySelector('.paper-detail.active')) {
        restoreScrollY = window.scrollY;
      }

      if (mainContent) {
        mainContent.style.transition = 'opacity 150ms ease';
        mainContent.style.opacity = '0';
        mainContent.style.pointerEvents = 'none';
      }

      restoreFocus = document.activeElement as HTMLElement | null;

      detail.classList.add('visible');
      void detail.offsetHeight; // reflow so the animation kicks in
      detail.classList.add('active');
      detail.setAttribute('aria-hidden', 'false');
      sealBackground(detail);
      // Into the dialog, at the control that leaves it.
      detail.querySelector<HTMLElement>('.back-btn')?.focus();
      // The overlay scrolls internally, so it is this element that starts at
      // the top — not the page, whose offset we are preserving.
      detail.scrollTop = 0;
      document.body.style.overflow = 'hidden';
      notifyDemos();

      // Update hash so detail is linkable / back-button closeable
      if (window.location.hash !== `#paper-${slug}`) {
        history.pushState(null, '', `#paper-${slug}`);
      }
    }

    function closeDetail(updateHistory = true) {
      const active = document.querySelector<HTMLElement>('.paper-detail.active');
      if (!active) return;

      active.classList.remove('active');
      active.setAttribute('aria-hidden', 'true');
      unsealBackground();
      notifyDemos();

      // Back where they were, not at the top of the document.
      restoreFocus?.focus({ preventScroll: true });
      restoreFocus = null;

      setTimeout(() => {
        active.classList.remove('visible');
        document.body.style.overflow = '';
        if (mainContent) {
          mainContent.style.opacity = '1';
          mainContent.style.pointerEvents = '';
        }
        // After the lock lifts, so the page can actually take the offset.
        window.scrollTo({ top: restoreScrollY, behavior: 'instant' as ScrollBehavior });
        notifyDemos();
      }, 200);

      if (updateHistory && window.location.hash.startsWith('#paper-')) {
        history.pushState(null, '', window.location.pathname + window.location.search);
      }
    }

    // Bind only explicit triggers. Binding every [data-slug] element also
    // caught descendants and containers, which made it impossible to nest
    // other controls (links, demo buttons) inside a card.
    document.querySelectorAll<HTMLElement>('[data-open-paper]').forEach(el => {
      el.addEventListener('click', (e) => {
        // Let a nested link or other control handle its own click.
        if ((e.target as Element).closest('a, button') !== el) return;
        const slug = el.dataset.openPaper;
        if (slug) openDetail(slug);
      });
      // Native <button> elements already fire click on Enter and Space, so
      // no key handling is needed here.
    });

    // Close buttons / margin clicks
    document.querySelectorAll<HTMLElement>('[data-action="close-detail"]').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        closeDetail();
      });
    });

    // Escape key closes
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeDetail();
    });

    // Back/forward button support — sync with hash
    window.addEventListener('popstate', () => {
      const hash = window.location.hash;
      if (hash.startsWith('#paper-')) {
        openDetail(hash.slice(7));
      } else {
        closeDetail(false);
      }
    });

    // If page loads with a paper hash, open that detail
    const hash = window.location.hash;
    if (hash.startsWith('#paper-')) {
      openDetail(hash.slice(7));
    }
  }

  initPaperDetailOverlays();
  document.addEventListener('astro:after-swap', initPaperDetailOverlays);
</script>
