---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getGallery } from '../lib/data';

const events = getGallery();
---

<BaseLayout title="Gallery">
  <div class="container">
    <div class="gallery-header">
      <div>
        <h1 class="page-title">Gallery</h1>
        <p class="page-subtitle">I take (film) photos at conference trips &amp; travels</p>
      </div>
      <button class="expand-all-btn" id="expand-all-btn">Expand all</button>
    </div>

    <div class="tree-timeline" id="tree-timeline">
      <div class="trunk" aria-hidden="true">
        <div class="trunk-roots" aria-hidden="true"></div>
      </div>
      <div class="canopy" aria-hidden="true"></div>

      {events.map((ev, idx) => {
        // Built from local parts, not from `new Date('2026-04-01')`. That form
        // parses as UTC midnight and then formats in the *build machine's*
        // zone, so anywhere west of UTC every album rendered a month early —
        // April 2026 came out as March, and January as the previous December.
        const [evYear, evMonth] = ev.date.split('-').map(Number);
        const dateLabel = new Date(evYear, evMonth - 1, 1)
          .toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
        const side = idx % 2 === 0 ? 'left' : 'right';

        return (
          <div class={`branch branch--${side}`} data-event-index={idx}>
            <div class="branch-arm" aria-hidden="true">
              <svg class="branch-svg" viewBox="0 0 80 30" preserveAspectRatio="none">
                <path d={side === 'left'
                  ? "M80,15 C60,15 40,8 0,12"
                  : "M0,15 C20,15 40,8 80,12"
                } stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round"/>
              </svg>
            </div>

            <button
              class="branch-node"
              aria-label={`Expand ${ev.event} photos`}
              aria-expanded="false"
            >
              <span class="node-ring"></span>
            </button>

            <div class="leaf-card">
              <h3 class="event-name">{ev.event}</h3>
              <p class="event-meta">{ev.location} &middot; {dateLabel}</p>
              <span class="photo-count">{ev.photos.length} photos</span>
            </div>

            <div class="collage-wrapper" aria-hidden="true">
              <div class="collage">
                {ev.photos.map((photo, pi) => (
                  <button
                    class:list={['photo-cell', { 'live-photo': photo.type === 'live' }]}
                    data-full={`/assets/img/${photo.src}`}
                    data-caption={photo.caption ?? ''}
                    data-video={photo.video ? `/assets/img/${photo.video}` : ''}
                    data-type={photo.type ?? 'image'}
                    aria-label={photo.caption ?? 'Gallery photo'}
                    style={`--leaf-delay: ${pi * 60}ms`}
                  >
                    <img
                      src={`/assets/img/${photo.thumb}`}
                      alt={photo.caption ?? `Photo from ${ev.event}`}
                      loading="lazy"
                      class="photo-thumb"
                    />
                    {photo.type === 'live' && (
                      <>
                        <video
                          src={`/assets/img/${photo.video}`}
                          muted
                          loop
                          playsinline
                          preload="none"
                          class="photo-video"
                        ></video>
                        <span class="live-badge">LIVE</span>
                      </>
                    )}
                  </button>
                ))}
              </div>
            </div>
          </div>
        );
      })}

      <div class="trunk-base" aria-hidden="true"></div>
    </div>
  </div>

  <!-- Lightbox overlay -->
  <div class="lightbox" id="lightbox" aria-hidden="true" role="dialog" aria-label="Photo viewer">
    <button class="lightbox-close" aria-label="Close lightbox">&times;</button>
    <button class="lightbox-prev" aria-label="Previous photo">&#8249;</button>
    <button class="lightbox-next" aria-label="Next photo">&#8250;</button>
    <div class="lightbox-content">
      {/* No `src=""`: an empty one is a request for the page itself on every
          gallery load. The lightbox sets src and alt when a photo opens. */}
      <img class="lightbox-img" alt="" />
      <video class="lightbox-video" src="" muted loop playsinline style="display:none"></video>
      <p class="lightbox-caption"></p>
    </div>
  </div>
</BaseLayout>

<style lang="scss">
  .gallery-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 2.5rem;
  }

  .page-title {
    font-family: 'Fraunces', serif;
    font-size: 2.2rem;
    margin-bottom: 0.25rem;
  }

  .page-subtitle {
    font-size: 1rem;
    color: var(--color-text-muted);
  }

  .expand-all-btn {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.78rem;
    font-weight: 500;
    padding: 0.45em 1em;
    border-radius: 999px;
    border: 1px solid var(--bg-surface-border);
    color: var(--color-text-muted);
    background: var(--bg-surface);
    cursor: pointer;
    transition: all var(--transition-fast);
    white-space: nowrap;
    margin-top: 0.5rem;

    &:hover {
      border-color: var(--color-primary);
      color: var(--color-primary);
    }
  }

  // =========================================================================
  // Tree Timeline
  // =========================================================================
  .tree-timeline {
    position: relative;
    max-width: 750px;
    margin: 0 auto;
    padding-bottom: 3rem;
    padding-top: 1.5rem;
  }

  // Trunk — the main tree stem
  .trunk {
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 4px;
    transform: translateX(-50%);
    background: var(--color-primary);
    border-radius: 2px;
    // Bark-like texture via gradient
    background-image: linear-gradient(
      to bottom,
      var(--color-primary) 0%,
      var(--color-secondary) 30%,
      var(--color-primary) 50%,
      var(--color-secondary) 70%,
      var(--color-accent) 100%
    );
  }

  // Small canopy circle at top of tree
  .canopy {
    position: absolute;
    left: 50%;
    top: -12px;
    width: 24px;
    height: 24px;
    transform: translateX(-50%);
    border-radius: 50%;
    background: var(--color-secondary);
    opacity: 0.6;
    box-shadow: 0 0 12px var(--color-highlight-glow);
  }

  // Roots at bottom
  .trunk-base {
    position: relative;
    margin-top: 1rem;
    height: 20px;
    &::before, &::after {
      content: '';
      position: absolute;
      bottom: 0;
      width: 30px;
      height: 2px;
      background: var(--color-accent);
      border-radius: 2px;
      opacity: 0.4;
    }
    &::before {
      left: calc(50% - 20px);
      transform: rotate(30deg);
    }
    &::after {
      left: calc(50% - 10px);
      transform: rotate(-25deg);
    }
  }

  // =========================================================================
  // Branch
  // =========================================================================
  .branch {
    position: relative;
    margin-bottom: 2rem;

    &--left {
      .leaf-card {
        text-align: right;
        margin-right: calc(50% + 2.5rem);
      }

      .branch-arm {
        position: absolute;
        right: calc(50% - 2rem);
        top: 6px;
        width: 4.5rem;
        height: 30px;
      }

      .branch-node {
        position: absolute;
        right: calc(50% + 2.2rem);
        top: 4px;
      }
    }

    &--right {
      .leaf-card {
        text-align: left;
        margin-left: calc(50% + 2.5rem);
      }

      .branch-arm {
        position: absolute;
        left: calc(50% - 2rem);
        top: 6px;
        width: 4.5rem;
        height: 30px;
      }

      .branch-node {
        position: absolute;
        left: calc(50% + 2.2rem);
        top: 4px;
      }
    }
  }

  .branch-arm {
    color: var(--color-secondary);
    opacity: 0.7;
  }

  .branch-svg {
    width: 100%;
    height: 100%;
  }

  .branch-node {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--bg-primary);
    border: 2.5px solid var(--color-secondary);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    cursor: pointer;
    transition: all var(--transition-fast);
    padding: 0;

    .node-ring {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--color-secondary);
      transition: all var(--transition-fast);
    }

    &:hover, &[aria-expanded="true"] {
      background: var(--color-secondary);
      transform: scale(1.3);
      box-shadow: 0 0 10px var(--color-highlight-glow);

      .node-ring {
        background: var(--bg-primary);
      }
    }
  }

  // Leaf-shaped card
  .leaf-card {
    cursor: pointer;
    padding: 0.65rem 1rem;
    background: var(--bg-surface);
    border: 1px solid var(--bg-surface-border);
    border-radius: 20px 6px 20px 6px;
    transition: all var(--transition-fast);
    position: relative;

    &:hover {
      border-color: var(--color-secondary);
      box-shadow: 0 2px 12px var(--color-highlight-glow);
    }
  }

  .event-name {
    font-family: 'DM Sans', sans-serif;
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 0.1rem;
    line-height: 1.3;
    color: var(--color-primary);
  }

  .event-meta {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin-bottom: 0.1rem;
  }

  .photo-count {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.68rem;
    color: var(--color-secondary);
  }

  // =========================================================================
  // Collage (inline expand)
  // =========================================================================
  .collage-wrapper {
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    transition: max-height 500ms cubic-bezier(0.4, 0, 0.2, 1),
                opacity 350ms ease;

    &.expanded {
      opacity: 1;
    }
  }

  .collage {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
    gap: 0.5rem;
    padding: 0.75rem 0 1.25rem;
  }

  .photo-cell {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius-md);
    cursor: pointer;
    padding: 0;
    border: 2px solid transparent;
    background: var(--bg-surface-border);
    clip-path: inset(0 0 100% 0);
    transition: clip-path 400ms cubic-bezier(0.4, 0, 0.2, 1) var(--leaf-delay, 0ms),
                border-color var(--transition-fast),
                transform var(--transition-fast);

    .expanded & {
      clip-path: inset(0 0 0 0);
    }

    &:hover {
      border-color: var(--color-primary);
      transform: scale(1.04);
    }

    img, video {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .photo-video {
      position: absolute;
      inset: 0;
      opacity: 0;
      transition: opacity 200ms ease;
    }

    &.live-photo:hover .photo-video {
      opacity: 1;
    }
  }

  .live-badge {
    position: absolute;
    bottom: 4px;
    right: 4px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.6rem;
    font-weight: 600;
    padding: 0.1em 0.4em;
    border-radius: var(--radius-sm);
    background: rgba(0, 0, 0, 0.55);
    color: #fff;
    letter-spacing: 0.04em;
    pointer-events: none;
  }

  // =========================================================================
  // Lightbox
  // =========================================================================
  .lightbox {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 500;
    background: rgba(0, 0, 0, 0.92);
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 200ms ease;

    &.visible {
      display: flex;
      flex-direction: column;
    }

    &.active {
      opacity: 1;
    }
  }

  .lightbox-close {
    position: absolute;
    top: 1rem;
    right: 1.5rem;
    font-size: 2.5rem;
    color: #fff;
    z-index: 10;
    line-height: 1;
    opacity: 0.7;

    &:hover { opacity: 1; }
  }

  .lightbox-prev,
  .lightbox-next {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    font-size: 3rem;
    color: #fff;
    z-index: 10;
    opacity: 0.6;
    padding: 0.5rem;

    &:hover { opacity: 1; }
  }

  .lightbox-prev { left: 1rem; }
  .lightbox-next { right: 1rem; }

  .lightbox-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 90vw;
    max-height: 85vh;
  }

  .lightbox-img,
  .lightbox-video {
    max-width: 90vw;
    max-height: 80vh;
    object-fit: contain;
    border-radius: var(--radius-md);
    background: #333;
    min-width: 300px;
    min-height: 200px;
  }

  .lightbox-caption {
    margin-top: 0.75rem;
    color: #ccc;
    font-size: 0.9rem;
    text-align: center;
  }

  // =========================================================================
  // Responsive — collapse to single-column
  // =========================================================================
  @media (max-width: 768px) {
    .trunk {
      left: 1.25rem;
      transform: none;
    }

    .canopy {
      left: 1.25rem;
      transform: translateX(-50%);
    }

    .trunk-base {
      &::before { left: 0; }
      &::after { left: 0.5rem; }
    }

    .branch {
      margin-bottom: 1.5rem;

      .leaf-card {
        text-align: left !important;
        margin-left: 3.5rem !important;
        margin-right: 0 !important;
      }

      .branch-arm {
        position: absolute;
        left: 0 !important;
        right: auto !important;
        top: 8px;
        width: 3rem;
      }

      .branch-node {
        position: absolute;
        left: 2.8rem !important;
        right: auto !important;
        top: 4px;
      }

      // Flip right-side branch SVGs for mobile
      &--left .branch-svg {
        transform: scaleX(-1);
      }
    }

    .collage {
      grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
    }

    .gallery-header {
      flex-direction: column;
      gap: 0.75rem;
    }
  }
</style>

<script>
  function initGallery() {
    const branches = document.querySelectorAll<HTMLElement>('.branch');
    const expandAllBtn = document.getElementById('expand-all-btn');
    let allExpanded = false;

    function toggleBranch(branch: HTMLElement, forceOpen?: boolean) {
      const node = branch.querySelector<HTMLButtonElement>('.branch-node');
      const wrapper = branch.querySelector<HTMLElement>('.collage-wrapper');
      if (!node || !wrapper) return;

      const isExpanded = node.getAttribute('aria-expanded') === 'true';
      const shouldOpen = forceOpen !== undefined ? forceOpen : !isExpanded;

      if (shouldOpen && !isExpanded) {
        node.setAttribute('aria-expanded', 'true');
        wrapper.classList.add('expanded');
        wrapper.setAttribute('aria-hidden', 'false');

        const collage = wrapper.querySelector<HTMLElement>('.collage');
        if (collage) {
          wrapper.style.maxHeight = collage.scrollHeight + 32 + 'px';
        }

        // Auto-play live photo videos on hover
        wrapper.querySelectorAll<HTMLElement>('.live-photo').forEach(cell => {
          const video = cell.querySelector<HTMLVideoElement>('video');
          if (!video) return;
          cell.addEventListener('mouseenter', () => {
            video.currentTime = 0;
            video.play().catch(() => {});
          });
          cell.addEventListener('mouseleave', () => {
            video.pause();
          });
        });
      } else if (!shouldOpen && isExpanded) {
        node.setAttribute('aria-expanded', 'false');
        wrapper.style.maxHeight = '0';
        wrapper.classList.remove('expanded');
        wrapper.setAttribute('aria-hidden', 'true');
      }
    }

    branches.forEach(branch => {
      const toggle = () => toggleBranch(branch);
      branch.querySelector<HTMLButtonElement>('.branch-node')?.addEventListener('click', toggle);
      branch.querySelector<HTMLElement>('.leaf-card')?.addEventListener('click', toggle);
    });

    // Expand all / Collapse all
    expandAllBtn?.addEventListener('click', () => {
      allExpanded = !allExpanded;
      branches.forEach((branch, i) => {
        setTimeout(() => {
          toggleBranch(branch, allExpanded);
        }, i * 80);
      });
      expandAllBtn.textContent = allExpanded ? 'Collapse all' : 'Expand all';
    });
  }

  // =========================================================================
  // Lightbox
  // =========================================================================
  function initGalleryLightbox() {
    const lightbox = document.getElementById('lightbox');
    const lbImg = lightbox?.querySelector<HTMLImageElement>('.lightbox-img');
    const lbVideo = lightbox?.querySelector<HTMLVideoElement>('.lightbox-video');
    const lbCaption = lightbox?.querySelector<HTMLElement>('.lightbox-caption');
    const closeBtn = lightbox?.querySelector<HTMLElement>('.lightbox-close');
    const prevBtn = lightbox?.querySelector<HTMLElement>('.lightbox-prev');
    const nextBtn = lightbox?.querySelector<HTMLElement>('.lightbox-next');

    if (!lightbox || !lbImg || !lbVideo || !lbCaption) return;

    let allPhotos: { src: string; caption: string; video: string; type: string }[] = [];
    let currentIndex = 0;

    const cells = document.querySelectorAll<HTMLButtonElement>('.photo-cell');
    cells.forEach((cell, i) => {
      allPhotos.push({
        src: cell.dataset.full ?? '',
        caption: cell.dataset.caption ?? '',
        video: cell.dataset.video ?? '',
        type: cell.dataset.type ?? 'image',
      });

      cell.addEventListener('click', () => {
        currentIndex = i;
        showPhoto();
        openLightbox();
      });
    });

    function showPhoto() {
      const photo = allPhotos[currentIndex];
      if (!photo) return;

      if (photo.type === 'live' && photo.video) {
        lbImg!.style.display = 'none';
        lbVideo!.style.display = 'block';
        lbVideo!.src = photo.video;
        lbVideo!.play().catch(() => {});
      } else {
        lbVideo!.style.display = 'none';
        lbVideo!.pause();
        lbImg!.style.display = 'block';
        lbImg!.src = photo.src;
        lbImg!.alt = photo.caption;
      }
      lbCaption!.textContent = photo.caption;
    }

    function openLightbox() {
      lightbox!.classList.add('visible');
      void lightbox!.offsetHeight;
      lightbox!.classList.add('active');
      lightbox!.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
      lbVideo!.pause();
      lightbox!.classList.remove('active');
      setTimeout(() => {
        lightbox!.classList.remove('visible');
        lightbox!.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }, 200);
    }

    function prevPhoto() {
      currentIndex = (currentIndex - 1 + allPhotos.length) % allPhotos.length;
      showPhoto();
    }

    function nextPhoto() {
      currentIndex = (currentIndex + 1) % allPhotos.length;
      showPhoto();
    }

    closeBtn?.addEventListener('click', closeLightbox);
    prevBtn?.addEventListener('click', prevPhoto);
    nextBtn?.addEventListener('click', nextPhoto);

    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox || e.target === lightbox.querySelector('.lightbox-content')) {
        closeLightbox();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (!lightbox.classList.contains('active')) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowLeft') prevPhoto();
      if (e.key === 'ArrowRight') nextPhoto();
    });
  }

  initGallery();
  initGalleryLightbox();
  document.addEventListener('astro:after-swap', () => {
    initGallery();
    initGalleryLightbox();
  });
</script>
