---
import { Image } from 'astro:assets';
import profilePhoto from '../assets/profile.jpg';
import BaseLayout from '../layouts/BaseLayout.astro';
import JobMarketBanner from '../components/JobMarketBanner.astro';
import NewsSection from '../components/NewsSection.astro';
import SelectedWork from '../components/SelectedWork.astro';
import PublicationEntry from '../components/PublicationEntry.astro';
import PaperDetailOverlays from '../components/PaperDetailOverlays.astro';
import {
  getSelectedPublications,
  getConferencePublications,
  getWorkshopPublications,
  getManuscriptsUnderReview,
  getSiteConfig,
  publicationToItem,
  manuscriptToItem,
} from '../lib/data';

const selectedPubs = getSelectedPublications();
const conferencePubs = getConferencePublications();
const workshopPubs = getWorkshopPublications();
const manuscripts = getManuscriptsUnderReview();
const reviewLabel = getSiteConfig().manuscripts_under_review.label;

/**
 * Selected-work themes, mirroring the research statement. A theme renders
 * only when it has at least one item, so the set of headings follows from
 * which papers are marked `selected`.
 */
const themes = [
  {
    key: 'when-ai-acts',
    label: 'When AI should act',
    gloss: 'Deciding when an AI system should interrupt, and what that costs.',
  },
  {
    key: 'what-it-shows',
    label: 'What it should show you',
    gloss: "Making an agent's plans and decisions into things you can edit.",
  },
  {
    key: 'where-direction-applies',
    label: 'Where your direction applies',
    gloss: 'Carrying a correction across tasks, agents, and sessions.',
  },
  {
    key: 'foundations',
    label: 'Foundations',
    gloss: 'Specifying intent for automation.',
  },
];

// Each theme collects published papers plus any featured manuscript. A
// manuscript only appears once the disclosure flag is on, so a theme whose
// work is all under review simply does not render until then.
const themed = themes
  .map(t => ({
    ...t,
    items: [
      ...selectedPubs.filter(p => p.category === t.key).map(publicationToItem),
      ...manuscripts
        .filter(m => m.selected && m.category === t.key)
        .map(m => manuscriptToItem(m, reviewLabel)),
    ],
  }))
  .filter(t => t.items.length > 0);

// Full list, newest first.
const years = [...new Set(conferencePubs.map(p => p.year))].sort((a, b) => b - a);
const byYear = years.map(year => ({
  year,
  pubs: conferencePubs.filter(p => p.year === year),
}));

const contactLinks = [
  { label: 'CV', href: '/assets/pdf/Kevin_Jiankai_Pu_Research_CV.pdf', external: true },
  { label: 'Google Scholar', href: 'https://scholar.google.com/citations?user=TsENWEIAAAAJ', external: true },
  { label: 'Twitter/X', href: 'https://twitter.com/kevpjk', external: true },
  { label: 'Gallery', href: '/gallery/', external: false },
  { label: 'Email', href: 'mailto:jpu@dgp.toronto.edu', external: false },
];
---

<BaseLayout title="Kevin Pu">
  <div class="home container">
    <JobMarketBanner />

    <div class="home-grid">
      <aside class="home-side">
        <Image
          src={profilePhoto}
          alt="Kevin Pu"
          class="side-photo"
          widths={[120, 180, 360]}
          sizes="(max-width: 900px) 96px, 150px"
          width={360}
          height={360}
          loading="eager"
          fetchpriority="high"
        />

        <div class="side-identity">
          <h1 class="side-name">Kevin Pu</h1>
          <p class="side-role">PhD Candidate, Computer Science<br />University of Toronto</p>
          <p class="side-affil">
            Advised by <a href="https://www.tovigrossman.com/" target="_blank" rel="noopener noreferrer">Tovi Grossman</a>
            and <a href="https://chensivan.github.io/" target="_blank" rel="noopener noreferrer">Yan Chen</a>
            at the <a href="https://www.dgp.toronto.edu/" target="_blank" rel="noopener noreferrer">DGP Lab</a>.
          </p>
        </div>

        <nav class="side-links" aria-label="Profiles and contact">
          {contactLinks.map(l => (
            <a
              href={l.href}
              {...(l.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >{l.label}</a>
          ))}
        </nav>
      </aside>

      <div class="home-main">
        <section class="home-bio" aria-label="About">
          <p>
            I work at the intersection of human-computer interaction and AI. I build and study
            interactive systems that decide <strong>when</strong> an AI system should act,
            make <strong>what</strong> it did inspectable, and carry a person's
            <strong>direction</strong> across tasks and sessions &mdash; keeping people in
            control of increasingly autonomous tools.
          </p>
        </section>

        <NewsSection limit={3} />

        <section class="home-section" id="selected" aria-labelledby="selected-heading">
          <h2 class="section-title" id="selected-heading">Selected Work</h2>

          {themed.map(theme => (
            <div class="theme-group">
              <div class="theme-head">
                <h3 class="theme-label">{theme.label}</h3>
                <p class="theme-gloss">{theme.gloss}</p>
              </div>
              {theme.items.map(item => <SelectedWork item={item} />)}
            </div>
          ))}
        </section>

        <section class="home-section" id="publications" aria-labelledby="publications-heading">
          <h2 class="section-title" id="publications-heading">All Publications</h2>

          {byYear.map(group => (
            <div class="year-group">
              <h3 class="year-label">{group.year}</h3>
              {group.pubs.map(pub => <PublicationEntry pub={pub} />)}
            </div>
          ))}

          {workshopPubs.length > 0 && (
            <div class="year-group">
              <h3 class="year-label">Workshop Papers</h3>
              {workshopPubs.map(pub => <PublicationEntry pub={pub} />)}
            </div>
          )}
        </section>
      </div>
    </div>
  </div>

  <PaperDetailOverlays />
</BaseLayout>

<style lang="scss">
  .home { padding-bottom: 4rem; }

  .home-grid {
    display: grid;
    grid-template-columns: 224px minmax(0, 1fr);
    gap: 3.5rem;
    align-items: start;
  }

  // --- Sidebar -------------------------------------------------------------
  .home-side {
    position: sticky;
    top: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .side-photo {
    width: 150px;
    height: 150px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--bg-surface-border);
  }

  .side-name {
    font-family: 'Fraunces', serif;
    font-size: 2rem;
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.015em;
    margin: 0 0 0.4rem;
  }

  .side-role {
    margin: 0 0 0.55rem;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.84rem;
    font-weight: 500;
    line-height: 1.5;
    color: var(--color-text);
  }

  .side-affil {
    margin: 0;
    font-size: 0.8rem;
    line-height: 1.6;
    color: var(--color-text-muted);

    a {
      color: var(--color-text-muted);
      text-decoration: underline;
      text-underline-offset: 0.18em;
      text-decoration-color: var(--bg-surface-border);
      &:hover { color: var(--color-primary); text-decoration-color: currentColor; }
    }
  }

  .side-links {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    letter-spacing: 0.02em;

    a {
      color: var(--color-text-muted);
      text-decoration: underline;
      text-underline-offset: 0.2em;
      text-decoration-color: var(--bg-surface-border);
      width: fit-content;

      &:hover {
        color: var(--color-primary);
        text-decoration-color: currentColor;
      }
    }
  }

  // --- Main column ---------------------------------------------------------
  .home-main { min-width: 0; }

  .home-bio p {
    margin: 0;
    font-size: 1.06rem;
    line-height: 1.72;

    strong {
      color: var(--color-primary);
      font-weight: 600;
    }
  }

  .home-section { margin-top: 3.25rem; }

  .section-title {
    font-family: 'Fraunces', serif;
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-primary);
    margin: 0;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--color-primary);
  }

  // --- Themes --------------------------------------------------------------
  .theme-group { margin-top: 2rem; }

  .theme-head {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    flex-wrap: wrap;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--bg-surface-border);
  }

  .theme-label {
    margin: 0;
    font-family: 'DM Sans', sans-serif;
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--color-text);
    white-space: nowrap;
  }

  .theme-gloss {
    margin: 0;
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--color-text-muted);
  }





  // --- Year groups ---------------------------------------------------------
  .year-group { margin-top: 1.75rem; }

  .year-label {
    margin: 0 0 0.5rem;
    padding-bottom: 0.35rem;
    border-bottom: 1px solid var(--bg-surface-border);
    font-family: 'Fraunces', serif;
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text-muted);
    letter-spacing: 0.01em;
  }

  // --- Responsive ----------------------------------------------------------
  @media (max-width: 900px) {
    .home-grid {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }

    .home-side {
      position: static;
      flex-direction: row;
      align-items: flex-start;
      flex-wrap: wrap;
      gap: 1.25rem;
    }

    .side-photo { width: 96px; height: 96px; }

    .side-identity { flex: 1 1 16rem; min-width: 0; }

    .side-links {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.75rem;
      flex-basis: 100%;
    }
  }

  @media (max-width: 480px) {
    .side-name { font-size: 1.6rem; }
    .home-bio p { font-size: 0.96rem; }
    .section-title { font-size: 1.25rem; }
    .theme-label { font-size: 0.98rem; white-space: normal; }
  }
</style>

<script>
  import '../scripts/demo-loader';
</script>
