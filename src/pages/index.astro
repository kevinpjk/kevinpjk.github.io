---
import { Image } from 'astro:assets';
import profilePhoto from '../assets/profile.jpg';
import BaseLayout from '../layouts/BaseLayout.astro';
import JobMarketBanner from '../components/JobMarketBanner.astro';
import NewsSection from '../components/NewsSection.astro';
import PublicationCard from '../components/PublicationCard.astro';
import PaperDetailOverlays from '../components/PaperDetailOverlays.astro';
import { getSelectedPublications, getVenues } from '../lib/data';

const selectedPubs = getSelectedPublications();
const venues = getVenues();

/**
 * Selected-work themes, mirroring the structure of the research statement.
 *
 * `pending` marks a theme whose work is still under review. It renders with
 * its heading and gloss but no paper list, so the three-part structure stays
 * visible without naming unpublished manuscripts. Enabling
 * `manuscripts_under_review` in site.yaml fills it in.
 */
const categories = [
  {
    key: 'when-ai-acts',
    label: 'When AI should act',
    gloss: 'Deciding when an AI system should interrupt, and what that costs.',
  },
  {
    key: 'what-it-shows',
    label: 'What it should show you',
    gloss: "Making an agent's plans and decisions into things you can edit.",
  },
  {
    key: 'where-direction-applies',
    label: 'Where your direction applies',
    gloss: 'Carrying a correction across tasks, agents, and sessions.',
  },
  {
    key: 'foundations',
    label: 'Foundations',
    gloss: 'Specifying intent for automation.',
  },
];

const pubsByCategory = categories
  .map(cat => ({
    ...cat,
    pubs: selectedPubs.filter(p => p.category === cat.key),
  }))
  // A theme with no published work still appears, as a heading and gloss.
  .filter(cat => cat.pubs.length > 0 || cat.key === 'where-direction-applies');
---

<BaseLayout title="Kevin Pu">
  <div class="landing container" id="landing-content">
    <JobMarketBanner />
    <div class="landing-grid">
      <div class="landing-left">
        <div class="hero-row stagger-in stagger-delay-1">
          <div class="hero-text">
            <h1 class="display-name">Kevin Pu</h1>
            <p class="title-line">PhD Candidate &middot; Computer Science &middot; University of Toronto</p>
            <p class="affiliations">
              Advised by Prof.&nbsp;<a href="https://www.tovigrossman.com/" target="_blank" rel="noopener noreferrer">Tovi Grossman</a>
              at the <a href="https://www.dgp.toronto.edu/" target="_blank" rel="noopener noreferrer">Dynamic Graphics Group</a>
              and Prof.&nbsp;<a href="https://chensivan.github.io/" target="_blank" rel="noopener noreferrer">Yan Chen</a>
            </p>
            <p class="contact-line">
              <a href="mailto:jpu@dgp.toronto.edu">jpu@dgp.toronto.edu</a>
              &middot;
              <a href="https://scholar.google.com/citations?user=TsENWEIAAAAJ" target="_blank" rel="noopener noreferrer" aria-label="Google Scholar">
                <svg class="contact-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M5.242 13.769L0 9.5 12 0l12 9.5-5.242 4.269C17.548 11.249 14.978 9.5 12 9.5c-2.977 0-5.548 1.748-6.758 4.269zM12 10a7 7 0 1 0 0 14 7 7 0 0 0 0-14z"/></svg>
                Scholar
              </a>
              &middot;
              <a href="https://twitter.com/kevpjk" target="_blank" rel="noopener noreferrer" aria-label="Twitter / X">
                <svg class="contact-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M23.954 4.569c-.885.389-1.83.654-2.825.775 1.014-.602 1.794-1.556 2.163-2.69-.949.555-2.005.959-3.127 1.184-.897-.949-2.178-1.54-3.594-1.54-2.723 0-4.928 2.174-4.928 4.857 0 .38.045.75.127 1.106-4.094-.203-7.725-2.139-10.157-5.082-.424.722-.666 1.561-.666 2.457 0 1.694.871 3.188 2.188 4.065-.807-.026-1.566-.245-2.228-.616v.061c0 2.367 1.717 4.342 3.995 4.793-.417.11-.856.171-1.309.171-.319 0-.63-.03-.932-.086.631 1.942 2.445 3.357 4.604 3.399-1.68 1.301-3.809 2.077-6.115 2.077-.398 0-.79-.023-1.175-.067 2.189 1.383 4.768 2.19 7.549 2.19 9.058 0 14.01-7.387 14.01-13.79 0-.21 0-.42-.015-.63.962-.689 1.8-1.56 2.46-2.548z"/></svg>
                Twitter
              </a>
            </p>
          </div>
          <Image
            src={profilePhoto}
            alt="Kevin Pu"
            class="profile-photo float-bob"
            widths={[110, 160, 320]}
            sizes="(max-width: 480px) 100px, (max-width: 768px) 110px, 160px"
            width={320}
            height={320}
            loading="eager"
            fetchpriority="high"
          />
        </div>

        <div class="bio stagger-in stagger-delay-2">
          <p>
            My research interests lie in intersection of human-computer interaction and AI.
            My past works have focused on aligning AI support with human capabilities to build harmonious
            <span class="keyword" data-category="when-ai-acts"><strong>mixed-initiative interaction</strong></span>, enhancing
            <span class="keyword" data-category="what-it-shows"><strong>human-AI collaboration</strong></span>
            <!-- <span class="keyword" data-category="neurosymbolic"><strong>neurosymbolic program synthesis</strong></span> -->
            workflows while balancing automation and human agency.
             <!-- for automation, programming, and ideation. -->
          </p>
        </div>

        <div class="stagger-in stagger-delay-4">
          <NewsSection />
        </div>
      </div>

      <div class="landing-right stagger-in stagger-delay-5">
        <div class="selected-pubs-header">
          <h2 class="section-heading">Selected Publications</h2>
          <a href="/publications/" class="show-all-link">Show all &rarr;</a>
        </div>

        {pubsByCategory.map(cat => (
          <div class="pub-category-group">
            <span class="category-label">{cat.label}</span>
            <p class="category-gloss">{cat.gloss}</p>
            {cat.pubs.length > 0 ? (
              <div class="pub-cards">
                {cat.pubs.map(pub => (
                  <PublicationCard pub={pub} venueInfo={venues[pub.venue]} />
                ))}
              </div>
            ) : (
              <p class="category-pending">Current work, under review.</p>
            )}
          </div>
        ))}
      </div>
    </div>
  </div>

  <PaperDetailOverlays />
</BaseLayout>

<style lang="scss">
  .landing-grid {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 3rem;
    align-items: start;
  }

  .landing-left { min-width: 0; }

  .hero-row {
    display: flex;
    align-items: flex-start;
    gap: 2rem;
  }

  .hero-text { flex: 1; min-width: 0; }

  .display-name {
    font-family: 'Fraunces', serif;
    font-size: 2.8rem;
    font-weight: 700;
    line-height: 1.15;
    margin-bottom: 0.3rem;
  }

  .title-line {
    font-size: 1.05rem;
    color: var(--color-text-muted);
    margin-bottom: 0.5rem;
  }

  .affiliations {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    line-height: 1.55;
    margin-bottom: 0.35rem;
  }

  .contact-line {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    display: flex;
    align-items: center;
    gap: 0.3em;
    flex-wrap: wrap;

    a {
      color: var(--color-text-muted);
      display: inline-flex;
      align-items: center;
      gap: 0.25em;
      &:hover { color: var(--color-primary); }
    }
  }

  .contact-icon {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }

  .profile-photo {
    width: 160px;
    height: 160px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid var(--bg-surface-border);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
    flex-shrink: 0;
  }

  .bio {
    margin-top: 1.5rem;
    font-size: 1rem;
    line-height: 1.7;
  }

  .keyword {
    cursor: default;
    padding: 0.05em 0.15em;
    border-radius: var(--radius-sm);
    transition: background-color var(--transition-fast);

    &:hover, &.highlighted {
      background-color: var(--color-highlight-glow);
    }

    strong { font-weight: 600; color: var(--color-primary); }
  }

  .landing-right {
    position: sticky;
    top: 2rem;
  }

  .selected-pubs-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 1.25rem;
  }

  .section-heading {
    font-size: 1.15rem;
    color: var(--color-primary);
  }

  .show-all-link {
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--color-text-muted);
    &:hover { color: var(--color-primary); }
  }

  .pub-category-group { margin-bottom: 1.5rem; }

  .category-gloss {
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--color-text-muted);
    margin: 0 0 0.6rem;
    padding-left: 0.15rem;
  }

  .category-pending {
    font-size: 0.82rem;
    color: var(--color-text-muted);
    font-style: italic;
    margin: 0;
    padding: 0.6rem 0.15rem;
    border-top: 1px dashed var(--bg-surface-border);
  }

  .category-label {
    display: block;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.68rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    margin-bottom: 0.5rem;
    padding-left: 0.15rem;
  }

  .pub-cards {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  @media (max-width: 1024px) {
    .landing-grid { grid-template-columns: 1fr; }
    .landing-right { position: static; }
  }

  @media (max-width: 768px) {
    .hero-row { gap: 1.25rem; }
    .display-name { font-size: 2.2rem; }
    .profile-photo { width: 110px; height: 110px; }
  }

  @media (max-width: 480px) {
    .hero-row {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 1rem;
    }

    .hero-text { text-align: center; }

    .contact-line { justify-content: center; }

    .display-name { font-size: 1.8rem; }

    .title-line { font-size: 0.92rem; }

    .affiliations { font-size: 0.88rem; }

    .profile-photo { width: 100px; height: 100px; }

    .bio { font-size: 0.92rem; }

    .selected-pubs-header { margin-top: 0.5rem; }

    .section-heading { font-size: 1.05rem; }
  }
</style>

<script>
  function initHighlighting() {
    const keywords = document.querySelectorAll<HTMLElement>('.keyword');
    const cards = document.querySelectorAll<HTMLElement>('.pub-card');

    keywords.forEach(kw => {
      const cat = kw.dataset.category;
      kw.addEventListener('mouseenter', () => {
        cards.forEach(card => { if (card.dataset.category === cat) card.classList.add('glow'); });
      });
      kw.addEventListener('mouseleave', () => {
        cards.forEach(card => card.classList.remove('glow'));
      });
    });

    cards.forEach(card => {
      const cat = card.dataset.category;
      card.addEventListener('mouseenter', () => {
        keywords.forEach(kw => { if (kw.dataset.category === cat) kw.classList.add('highlighted'); });
      });
      card.addEventListener('mouseleave', () => {
        keywords.forEach(kw => kw.classList.remove('highlighted'));
      });
    });
  }

  initHighlighting();
  document.addEventListener('astro:after-swap', initHighlighting);
</script>
