---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublications, getVenues } from '../lib/data';

const pubs = getPublications();
const venues = getVenues();

// Group by year, descending
const years = [...new Set(pubs.map(p => p.year))].sort((a, b) => b - a);
const pubsByYear = years.map(year => ({
  year,
  pubs: pubs.filter(p => p.year === year),
}));
---

<BaseLayout title="Publications">
  <div class="container">
    <h1 class="page-title stagger-in stagger-delay-1">Publications</h1>

    {pubsByYear.map(group => (
      <section class="year-group">
        <h2 class="year-heading">{group.year}</h2>
        <div class="pub-list">
          {group.pubs.map(pub => {
            const vi = venues[pub.venue];
            const venueColor = vi?.color ?? '#666';
            const venueLabel = `${pub.venue} '${String(pub.year).slice(2)}`;

            const linkItems = [
              { label: 'PDF', url: pub.links.pdf },
              { label: 'Video', url: pub.links.video },
              { label: 'arXiv', url: pub.links.arxiv },
              { label: 'Website', url: pub.links.website },
              { label: 'Code', url: pub.links.code },
            ].filter(l => l.url);

            return (
              <article class="pub-entry">
                <div class="pub-entry-top">
                  <span class="venue-badge" style={`background:${venueColor}`}>{venueLabel}</span>
                  {pub.selected && <span class="selected-marker" title="Selected publication">&#9733;</span>}
                  {pub.award && <span class="award-badge">{pub.award}</span>}
                </div>
                <h3 class="pub-entry-title">{pub.title}</h3>
                <p class="pub-entry-authors">
                  {pub.authors.map((a, i) => (
                    <span>
                      {a.url ? (
                        <a href={a.url} target="_blank" rel="noopener noreferrer" class:list={{ highlight: a.highlight }}>
                          {a.name}
                        </a>
                      ) : (
                        <span class:list={{ highlight: a.highlight }}>{a.name}</span>
                      )}
                      {i < pub.authors.length - 1 && ', '}
                    </span>
                  ))}
                </p>
                {linkItems.length > 0 && (
                  <div class="pub-entry-links">
                    {linkItems.map(l => (
                      <a href={l.url!} class="link-pill" target="_blank" rel="noopener noreferrer">
                        {l.label}
                      </a>
                    ))}
                  </div>
                )}
              </article>
            );
          })}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>

<style lang="scss">
  .page-title {
    font-family: 'Fraunces', serif;
    font-size: 2.2rem;
    margin-bottom: 2rem;
  }

  .year-group {
    margin-bottom: 2.5rem;
  }

  .year-heading {
    font-family: 'JetBrains Mono', monospace;
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: 1rem;
    padding-bottom: 0.4rem;
    border-bottom: 2px solid var(--bg-surface-border);
  }

  .pub-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .pub-entry {
    padding: 1rem 1.25rem;
    background: var(--bg-surface);
    border: 1px solid var(--bg-surface-border);
    border-radius: var(--radius-md);
    transition: border-color var(--transition-fast);

    &:hover {
      border-color: var(--color-secondary);
    }
  }

  .pub-entry-top {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
    flex-wrap: wrap;
  }

  .venue-badge {
    display: inline-block;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0.12em 0.55em;
    border-radius: 999px;
    color: #fff;
    white-space: nowrap;
  }

  .selected-marker {
    color: var(--color-accent);
    font-size: 0.9rem;
  }

  .award-badge {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-accent);
  }

  .pub-entry-title {
    font-family: 'DM Sans', sans-serif;
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.4;
    margin-bottom: 0.4rem;
  }

  .pub-entry-authors {
    font-size: 0.88rem;
    color: var(--color-text-muted);
    line-height: 1.55;
    margin-bottom: 0.6rem;

    .highlight {
      font-weight: 600;
      color: var(--color-text);
    }

    a {
      color: var(--color-primary);
      &:hover { color: var(--color-secondary); }
    }
  }

  .pub-entry-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .link-pill {
    display: inline-flex;
    align-items: center;
    font-size: 0.78rem;
    font-weight: 500;
    padding: 0.25em 0.7em;
    border-radius: 999px;
    border: 1px solid var(--bg-surface-border);
    color: var(--color-text-muted);
    transition: all var(--transition-fast);

    &:hover {
      border-color: var(--color-primary);
      color: var(--color-primary);
      background: var(--color-highlight-glow);
    }
  }
</style>
