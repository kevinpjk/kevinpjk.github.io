---
import BaseLayout from '../layouts/BaseLayout.astro';
import PaperDetailOverlays from '../components/PaperDetailOverlays.astro';
import { Image } from 'astro:assets';
import { getConferencePublications, getWorkshopPublications, getVenues, getTeaser } from '../lib/data';

const pubs = getConferencePublications();
const workshopPubs = getWorkshopPublications();
const venues = getVenues();

// Group by year, descending
const years = [...new Set(pubs.map(p => p.year))].sort((a, b) => b - a);
const pubsByYear = years.map(year => ({
  year,
  pubs: pubs.filter(p => p.year === year),
}));
---

<BaseLayout title="Publications">
  <div class="container">
    <h1 class="page-title stagger-in stagger-delay-1">Publications</h1>

    {pubsByYear.map(group => (
      <section class="year-group stagger-in" style={`animation-delay: ${120}ms`}>
        <h2 class="year-heading">{group.year}</h2>
        <div class="pub-list">
          {group.pubs.map(pub => {
            const venueLabel = `${pub.venue} '${String(pub.year).slice(2)}`;

            const linkItems = [
              { label: 'PDF', url: pub.links.pdf },
              { label: 'Video', url: pub.links.video },
              { label: 'arXiv', url: pub.links.arxiv },
              { label: 'DOI', url: pub.links.doi },
              { label: 'Website', url: pub.links.website },
              { label: 'Code', url: pub.links.code },
            ].filter(l => l.url);

            return (
              <article class="pub-entry" id={`pub-${pub.slug}`} data-slug={pub.slug}>
                <div class="pub-entry-body">
                  <div class="pub-entry-text">
                    <div class="pub-entry-top">
                      <span class="venue-label">{venueLabel}</span>
                      {pub.selected && <span class="selected-marker" title="Selected publication">&#9733;</span>}
                      {pub.award === 'Best Paper' ? (
                        <span class="award-badge">🏆 {pub.award}</span>
                      ) : pub.award ? (
                        <span class="award-badge">🥇 {pub.award}</span>
                      ) : null}
                    </div>
                    <h3 class="pub-entry-title">
                      <button class="pub-entry-open" data-open-paper={pub.slug}>{pub.title}</button>
                    </h3>
                    <p class="pub-entry-authors">
                      {pub.authors.map((a, i) => (
                        <span>
                          {a.url ? (
                            <a href={a.url} target="_blank" rel="noopener noreferrer" class:list={{ highlight: a.highlight }}
                               onclick="event.stopPropagation()">
                              {a.name}
                            </a>
                          ) : (
                            <span class:list={{ highlight: a.highlight }}>{a.name}</span>
                          )}
                          {i < pub.authors.length - 1 && ', '}
                        </span>
                      ))}
                    </p>
                    {linkItems.length > 0 && (
                      <div class="pub-entry-links">
                        {linkItems.map(l => (
                          <a href={l.url!} class="link-pill" target="_blank" rel="noopener noreferrer"
                             onclick="event.stopPropagation()">
                            {l.label}
                          </a>
                        ))}
                      </div>
                    )}
                  </div>
                  {getTeaser(pub.teaser) && (
                    <div class="pub-entry-teaser">
                      <Image
                        src={getTeaser(pub.teaser)!}
                        alt={`Teaser for ${pub.title}`}
                        widths={[240, 480]}
                        sizes="(max-width: 768px) 40vw, 200px"
                        loading="lazy"
                        decoding="async"
                      />
                    </div>
                  )}
                </div>
              </article>
            );
          })}
        </div>
      </section>
    ))}

    {workshopPubs.length > 0 && (
      <section class="year-group stagger-in">
        <h2 class="year-heading">Workshop Papers</h2>
        <div class="pub-list">
          {workshopPubs.map(pub => (
            <article class="pub-entry" id={`pub-${pub.slug}`}>
              <div class="pub-entry-body">
                <div class="pub-entry-text">
                  <div class="pub-entry-top">
                    <span class="venue-label">{pub.venue} '{String(pub.year).slice(2)}</span>
                  </div>
                  <h3 class="pub-entry-title">{pub.title}</h3>
                  <p class="pub-entry-authors">
                    {pub.authors.map((a, i) => (
                      <span>
                        {a.url ? (
                          <a href={a.url} target="_blank" rel="noopener noreferrer"
                             class:list={{ highlight: a.highlight }}>{a.name}</a>
                        ) : (
                          <span class:list={{ highlight: a.highlight }}>{a.name}</span>
                        )}
                        {i < pub.authors.length - 1 && ', '}
                      </span>
                    ))}
                  </p>
                  {pub.venue_full && <p class="pub-entry-venue-full">{pub.venue_full}</p>}
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>
    )}
  </div>
  <PaperDetailOverlays />
</BaseLayout>

<style lang="scss">
  .page-title {
    font-family: 'Fraunces', serif;
    font-size: 2.2rem;
    margin-bottom: 2rem;
  }

  .year-group {
    margin-bottom: 2.5rem;
  }

  .pub-entry { position: relative; }

  .pub-entry-open {
    padding: 0;
    text-align: left;
    font: inherit;
    color: inherit;

    &::after {
      content: '';
      position: absolute;
      inset: 0;
    }

    &:hover { text-decoration: underline; text-underline-offset: 0.15em; }
  }

  // Links inside the row must sit above the title button's overlay.
  .pub-entry-links,
  .pub-entry-authors a {
    position: relative;
    z-index: 1;
  }

  .pub-entry-venue-full {
    font-size: 0.82rem;
    color: var(--color-text-muted);
    margin-top: 0.3rem;
  }

  .year-heading {
    font-family: 'JetBrains Mono', monospace;
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: 1rem;
    padding-bottom: 0.4rem;
    border-bottom: 2px solid var(--bg-surface-border);
  }

  .pub-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .pub-entry {
    padding: 1rem 1.25rem;
    background: var(--bg-surface);
    border: 1px solid var(--bg-surface-border);
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: transform var(--transition-fast),
                box-shadow var(--transition-fast),
                border-color var(--transition-fast);

    &:hover {
      border-color: var(--color-secondary);
      transform: translateY(-2px);
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
    }
  }

  .pub-entry-body {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
  }

  .pub-entry-text {
    flex: 1;
    min-width: 0;
  }

  .pub-entry-teaser {
    flex-shrink: 0;
    width: 160px;
    max-height: 200px;
    overflow: hidden;
    border-radius: var(--radius-md);
    border: 1px solid var(--bg-surface-border);
    background: var(--bg-surface-border);

    img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      max-height: 160px;
    }
  }

  .pub-entry-top {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
    flex-wrap: wrap;
  }

  .venue-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .selected-marker {
    color: var(--color-accent);
    font-size: 0.9rem;
  }

  .award-badge {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-accent);
  }

  .pub-entry-title {
    font-family: 'DM Sans', sans-serif;
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.4;
    margin-bottom: 0.4rem;
  }

  .pub-entry-authors {
    font-size: 0.88rem;
    color: var(--color-text-muted);
    line-height: 1.55;
    margin-bottom: 0.6rem;

    .highlight {
      font-weight: 600;
      color: var(--color-text);
      text-decoration: underline;
      text-decoration-color: var(--color-secondary);
      text-underline-offset: 2px;
      text-decoration-thickness: 1.5px;
    }

    a {
      color: var(--color-primary);
      &:hover { color: var(--color-secondary); }
    }
  }

  .pub-entry-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .link-pill {
    display: inline-flex;
    align-items: center;
    font-size: 0.78rem;
    font-weight: 500;
    padding: 0.25em 0.7em;
    border-radius: 999px;
    border: 1px solid var(--bg-surface-border);
    color: var(--color-text-muted);
    transition: all var(--transition-fast);

    &:hover {
      border-color: var(--color-primary);
      color: var(--color-primary);
      background: var(--color-highlight-glow);
    }
  }

  @media (max-width: 600px) {
    .pub-entry-teaser {
      display: none;
    }
  }
</style>

